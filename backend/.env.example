# Copy to .env (not committed). Docker Compose and the npm scripts both read it.

# The dev database from docker-compose.yml. Inside Compose the backend uses the postgres service instead.
DATABASE_URL=postgres://workoutapp:devpassword@localhost:5432/workoutapp

# Signs login tokens. Any long random string; the server won't start without it.
JWT_SECRET=replace-with-a-long-random-string

# Optional. The API's port, 3000 if unset. On another port, set EXPO_PUBLIC_API_URL in the app.
# PORT=3000

# Optional. Vitest sets it to test, which turns off request logging. Leave unset otherwise.
# NODE_ENV=

# Optional, tests only. The test database; this is the default when unset (npm run test:local).
# TEST_DATABASE_URL=postgres://workoutapp:devpassword@localhost:5433/workoutapp_test
